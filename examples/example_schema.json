        {
          "id": "about-content",
          "componentId": "app-card",
          "gridPosition": {
            "column": 0,
            "row": 1,
            "colSpan": 12,
            "rowSpan": 1,
            "colStart": null,
            "rowStart": null
          },
          "classes": "",
          "children": [],
          "dataBinding": null
        }
      ]
