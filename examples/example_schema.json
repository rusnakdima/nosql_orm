{
  "schemaVersion": "1.0.0",
  "app": {
    "id": "example-app",
    "name": "Example SDUI App",
    "version": "1.0.0",
    "description": "Example schema-driven app using nosql_orm",
    "identifier": "com.example.sdui",
    "settings": {
      "defaultLocale": "en",
      "supportedLocales": ["en"],
      "tailwindPreset": "default",
      "theme": "default",
      "themes": [],
      "colorMode": "system"
    }
