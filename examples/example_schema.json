            "colSpan": 12,
            "rowSpan": 1,
            "colStart": null,
            "rowStart": null
          },
          "classes": "",
          "children": [],
          "dataBinding": null
        },
        {
          "id": "welcome-card",
          "componentId": "app-card",
          "gridPosition": {
            "column": 0,
            "row": 1,
            "colSpan": 6,
            "rowSpan": 1,
            "colStart": null,
            "rowStart": null
          },
          "classes": "",
          "children": [],
          "dataBinding": null
        },
        {
          "id": "stats-card",
          "componentId": "app-card",
          "gridPosition": {
            "column": 6,
            "row": 1,
            "colSpan": 6,
            "rowSpan": 1,
            "colStart": null,
            "rowStart": null
          },
          "classes": "",
          "children": [],
          "dataBinding": null
        },
        {
          "id": "action-card",
          "componentId": "app-card",
          "gridPosition": {
            "column": 0,
            "row": 2,
            "colSpan": 12,
            "rowSpan": 1,
            "colStart": null,
            "rowStart": null
          },
          "classes": "",
          "children": [],
          "dataBinding": null
        }
      ]
    },
    {
      "id": "about-page",
      "name": "About",
      "route": "/about",
      "layout": "default",
      "meta": {
        "title": "About",
        "icon": "info",
        "breadcrumb": ["Home", "About"]
      },
      "sections": {},
      "canvasElements": [
        {
          "id": "header-about",
          "componentId": "app-header",
          "gridPosition": {
            "column": 0,
            "row": 0,
            "colSpan": 12,
            "rowSpan": 1,
            "colStart": null,
            "rowStart": null
